{
  "manifest_version": 3,
  "name": "Focus Tracker 2.0",
  "version": "2.0",
  "description": "Track focus time, website usage and study tasks.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Focus Tracker"
  },
  "background": {
    "service_worker": "background.js"
  }
}
